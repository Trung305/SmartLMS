@model IPagedResult

@if (Model.TotalPages > 1)
{
    <nav aria-label="Phân trang" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <!-- Trang đầu -->
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" 
                asp-action="@ViewContext.RouteData.Values["action"]"
                asp-controller="@ViewContext.RouteData.Values["controller"]"
                asp-all-route-data="@Context.Request.Query.ToRouteData()"
                asp-route-page="1">
                    <i class="fas fa-angle-double-left"></i>
                </a>
            </li>

            <!-- Trang trước -->
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                asp-action="@ViewContext.RouteData.Values["action"]"
                asp-controller="@ViewContext.RouteData.Values["controller"]"
                asp-all-route-data="@Context.Request.Query.ToRouteData()"
                asp-route-page="@(Model.CurrentPage - 1)">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>

            <!-- Các trang gần -->
            @{
                int start = Math.Max(1, Model.CurrentPage - 2);
                int end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
            }

            @if (start > 1)
            {
                <li class="page-item">
                    <a class="page-link" 
                    asp-action="@ViewContext.RouteData.Values["action"]"
                    asp-controller="@ViewContext.RouteData.Values["controller"]"
                    asp-all-route-data="@Context.Request.Query.ToRouteData()"
                    asp-route-page="1">1</a>
                </li>
                @if (start > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }

            @for (int i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                    asp-action="@ViewContext.RouteData.Values["action"]"
                    asp-controller="@ViewContext.RouteData.Values["controller"]"
                    asp-all-route-data="@Context.Request.Query.ToRouteData()"
                    asp-route-page="@i">@i</a>
                </li>
            }

            @if (end < Model.TotalPages)
            {
                @if (end < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                    <li class="page-item">
                        <a class="page-link"
                       asp-action="@ViewContext.RouteData.Values["action"]"
                       asp-controller="@ViewContext.RouteData.Values["controller"]"
                       asp-all-route-data="@Context.Request.Query.ToRouteData()"
                       asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                </li>}
            }

            <!-- Trang sau -->
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-controller="@ViewContext.RouteData.Values["controller"]"
                   asp-all-route-data="@Context.Request.Query.ToRouteData()"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>

            <!-- Trang cuối -->
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="@ViewContext.RouteData.Values["action"]"
                   asp-controller="@ViewContext.RouteData.Values["controller"]"
                   asp-all-route-data="@Context.Request.Query.ToRouteData()"
                   asp-route-page="@Model.TotalPages">
                    <i class="fas fa-angle-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>

    <div class="text-center text-muted small mt-2">
        Trang @Model.CurrentPage / @Model.TotalPages 
        (@Model.TotalItems mục)
    </div>
}
