@model AdminCreateEditQuizViewModel
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        
    </div>
    <a onclick="showpopup('Quản lý bài học', '@Url.Action("Index", new { courseId = Model.CourseId })'); return false;" class="btn btn-secondary">
        <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại
    </a>

</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form id="createQuizForm" method="post" asp-action="@(Model.QuizId == null ? "Create" : "Edit")">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CourseId" />
            <input type="hidden" asp-for="LessonId" />
            <input type="hidden" asp-for="QuizId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

            <!-- Quiz Info Section -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">
                                    Tiêu đề bài kiểm tra <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Title" class="form-control" placeholder="VD: Kiểm tra kiến thức chương 1" maxlength="200" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Mô tả</label>
                                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Mô tả ngắn về bài kiểm tra..."></textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Loại bài kiểm tra</label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="QuizTypeRadio" id="quizTypeStandalone" value="standalone"
                                        @(Model.LessonId == null ? "checked" : "") />
                                        <label class="form-check-label" for="quizTypeStandalone">
                                            Tổng hợp
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="QuizTypeRadio" id="quizTypeLesson" value="lesson"
                                        @(Model.LessonId != null ? "checked" : "") />
                                        <label class="form-check-label" for="quizTypeLesson">
                                            Gắn bài học
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-8 mb-3" id="lessonSelectorContainer" style="@(Model.LessonId == null ? "display:none;" : "")">
                                    <label class="form-label">Chọn bài học</label>
                                    <select asp-for="LessonId" class="form-select" id="LessonIdSelect">
                                        <option value="">-- Chọn bài học --</option>
                                        @if (Model.AvailableLessons != null)
                                        {
                                            foreach (var lesson in Model.AvailableLessons)
                                            {
                                                <option value="@lesson.Id">@("Bài " + lesson.OrderIndex + ": " + lesson.Title)</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <label asp-for="PassingScore" class="form-label">
                                        Điểm đậu (%) <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="PassingScore" class="form-control" type="number" min="0" max="100" />
                                    <span asp-validation-for="PassingScore" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="MaxAttempts" class="form-label">
                                        Số lần làm <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="MaxAttempts" class="form-control" type="number" min="1" max="10" />
                                    <span asp-validation-for="MaxAttempts" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="IsTimedQuiz" asp-for="IsTimedQuiz" />
                                        <label class="form-check-label" for="IsTimedQuiz">Giới hạn thời gian</label>
                                    </div>
                                </div>
                            </div>

                            <div id="timeLimitContainer" class="mt-3" style="@(Model.IsTimedQuiz ? "" : "display:none;")">
                                <label asp-for="TimeLimit" class="form-label">Thời gian (phút)</label>
                                <input asp-for="TimeLimit" class="form-control" type="number" min="1" max="180" style="max-width: 200px;" />
                                <span asp-validation-for="TimeLimit" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6><i class="fas fa-info-circle me-2"></i>Tóm tắt</h6>
                                    <ul class="small mb-0">
                                        <li>Loại: <strong id="summaryType">Tổng hợp</strong></li>
                                        <li>Điểm đậu: <strong id="summaryPassing">@Model.PassingScore%</strong></li>
                                        <li>Số lần: <strong id="summaryAttempts">@Model.MaxAttempts</strong></li>
                                        <li>Thời gian: <strong id="summaryTime">@(Model.IsTimedQuiz ? Model.TimeLimit + " phút" : "Không giới hạn")</strong></li>
                                        <li>Câu hỏi: <strong id="summaryQuestions">0</strong></li>
                                        <li>Tổng điểm: <strong id="summaryPoints">0</strong></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" id="IsActive" asp-for="IsActive" checked />
                                <label class="form-check-label" for="IsActive">Kích hoạt bài kiểm tra</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-question-circle me-2"></i>
                        Câu hỏi (<span id="questionCount">0</span>)
                    </h5>
                    <button type="button" class="btn btn-light btn-sm" onclick="openQuestionModal()">
                        <i class="fas fa-plus me-1"></i>Thêm câu hỏi
                    </button>
                </div>
                <div class="card-body">
                    <div id="questionsList"></div>

                    <div id="emptyQuestionsState" class="text-center py-5">
                        <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                        <h5>Chưa có câu hỏi nào</h5>
                        <p class="text-muted">Thêm câu hỏi cho bài kiểm tra của bạn</p>
                        <button type="button" class="btn btn-success" onclick="openQuestionModal()">
                            <i class="fas fa-plus me-2"></i>Thêm câu hỏi đầu tiên
                        </button>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <div></div>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-save me-2"></i>Lưu bài kiểm tra
                </button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="questionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="questionModalTitle">Thêm câu hỏi mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editingIndex" value="-1">

                <div class="mb-4">
                    <label class="form-label fw-bold">Loại câu hỏi</label>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="questionType" id="typeSingle" value=1 checked>
                                <label class="form-check-label" for="typeSingle">
                                    <strong>Trắc nghiệm</strong>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="questionType" id="typeTrueFalse" value=3>
                                <label class="form-check-label" for="typeTrueFalse">
                                    <strong>Đúng / Sai</strong>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="questionType" id="typeEssay" value=4>
                                <label class="form-check-label" for="typeEssay">
                                    <strong>Tự luận</strong>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label"><span class="text-danger">*</span> Nội dung câu hỏi</label>
                    <textarea class="form-control" id="questionContent" rows="4" placeholder="Viết câu hỏi ở đây..."></textarea>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label"><span class="text-danger">*</span> Điểm số</label>
                        <input type="number" class="form-control" id="questionPoints" min="1" max="100" value="10">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Giải thích đáp án (hiển thị sau khi làm bài)</label>
                    <textarea class="form-control" id="questionExplanation" rows="3" placeholder="Giải thích chi tiết tại sao đáp án đúng/sai..."></textarea>
                </div>

                <div id="answersSection">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="form-label mb-0">
                            <span class="text-danger">*</span> Đáp án
                        </label>
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check mb-0">
                                <input class="form-check-input" name="typeMultiple" type="checkbox" id="typeMultiple" value=2>
                                <label class="form-check-label" for="typeMultiple">
                                    <strong>Chọn nhiều đáp án</strong>
                                </label>
                            </div>

                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    id="addAnswerBtn"
                                    onclick="addAnswerOption()"
                                    style="white-space: nowrap;">
                                <i class="fas fa-plus me-1"></i>Thêm đáp án
                            </button>
                        </div>
                    </div>
                    <div id="answersList">
                    </div>
                    <small class="text-muted">Đánh dấu đáp án đúng bằng cách chọn ô bên trái</small>
                </div>

                <div id="trueFalseSection" style="display:none;">
                    <label class="form-label mb-3">Chọn đáp án đúng</label>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="trueFalseAnswer" id="tfTrue" value="true">
                        <label class="form-check-label fw-bold text-success" for="tfTrue">Đúng</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="trueFalseAnswer" id="tfFalse" value="false">
                        <label class="form-check-label fw-bold text-danger" for="tfFalse">Sai</label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" onclick="saveQuestion()">
                    <i class="fas fa-save me-1"></i>Lưu câu hỏi
                </button>
            </div>
        </div>
    </div>
</div>
<style>
    .question-card {
        border-left: 4px solid #4e73df;
        transition: all 0.3s;
    }
    .question-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
    }
    .answer-option {
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .answer-option.correct {
        border-color: #28a745;
        background: #d4edda;
    }
    .badge-type {
        font-size: 0.85rem;
    }

    .admin-card {
        border-radius: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .admin-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
        }

    .form-control, .form-select, .form-control-file {
        border-radius: 8px;
        padding: 10px 15px;
    }

    .input-group-text {
        border-radius: 8px 0 0 8px;
        background: #f8f9fa;
    }

    .form-control:focus + .floating-label,
    .form-control:not(:placeholder-shown) + .floating-label,
    textarea.form-control:not(:empty) + .floating-label {
        top: 0;
        font-size: 0.75rem;
        background: #fff;
        padding: 0 5px;
        transform: translateY(-100%);
    }

    .form-control:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
    }

    .text-danger {
        font-size: 0.85rem;
        margin-top: 5px;
    }

    [data-theme="dark"] .admin-card {
        background: #2d3748;
        color: #e5e7eb;
    }

    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select,
    [data-theme="dark"] .input-group-text {
        background: #4a5568;
        color: #e5e7eb;
        border-color: #6b7280;
    }

    [data-theme="dark"] .floating-label {
        color: #d1d5db;
    }

    [data-theme="dark"] .form-control:focus + .floating-label,
    [data-theme="dark"] .form-control:not(:placeholder-shown) + .floating-label,
    [data-theme="dark"] textarea.form-control:not(:empty) + .floating-label {
        background: #4a5568;
    }

    [data-theme="dark"] .text-danger {
        color: #f87171;
    }
</style>
