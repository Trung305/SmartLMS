@model CourseCreateEditViewModel
@{
    ViewData["Title"] = "Tạo khóa học mới";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4" data-aos="fade-down">
        <h1 class="h3 mb-0 text-primary"><i class="fas fa-book-medical me-2"></i>Tạo khóa học mới</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <!-- Form -->
    <div class="card admin-card shadow-sm border-0" data-aos="fade-up">
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data" asp-action="Create" id="createCourseForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show d-none" role="alert" id="validationSummary">
                    <i class="fas fa-exclamation-circle me-2"></i>Vui lòng kiểm tra các lỗi bên dưới
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>

                <div class="row">
                    <!-- Left Column -->
                    <div class="col-md-8">
                        <div class="mb-3 position-relative">
                            <label asp-for="Title" class="form-label floating-label">Tiêu đề khóa học</label>
                            <input asp-for="Title" class="form-control" placeholder=" " />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="ShortDescription" class="form-label floating-label">Mô tả ngắn</label>
                            <textarea asp-for="ShortDescription" class="form-control" rows="3" placeholder=" "></textarea>
                            <span asp-validation-for="ShortDescription" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="Description" class="form-label floating-label">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="8" placeholder=" "></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="WhatYouWillLearn" class="form-label floating-label">Bạn sẽ học được gì</label>
                            <textarea asp-for="WhatYouWillLearn" class="form-control" rows="5" placeholder=" "></textarea>
                            <span asp-validation-for="WhatYouWillLearn" class="text-danger"></span>
                            <small class="text-muted">Mỗi dòng là một mục, bắt đầu bằng "-". Ví dụ: "- Kỹ năng 1"</small>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="Requirements" class="form-label floating-label">Yêu cầu đầu vào</label>
                            <textarea asp-for="Requirements" class="form-control" rows="4" placeholder=" "></textarea>
                            <span asp-validation-for="Requirements" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">Danh mục</label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InstructorId" class="form-label">Giảng viên</label>
                            <select asp-for="InstructorId" class="form-select">
                                <option value="">-- Chọn giảng viên --</option>
                                @foreach (var instructor in Model.Instructors)
                                {
                                    <option value="@instructor.Id">@instructor.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="InstructorId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Level" class="form-label">Cấp độ</label>
                            <select asp-for="Level" class="form-select">
                                <option value="@CourseLevel.Beginner">Cơ bản</option>
                                <option value="@CourseLevel.Intermediate">Trung cấp</option>
                                <option value="@CourseLevel.Advanced">Nâng cao</option>
                            </select>
                            <span asp-validation-for="Level" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsFree" class="form-check-input" id="isFree" />
                                <label asp-for="IsFree" class="form-check-label">Miễn phí</label>
                            </div>
                        </div>

                        <div class="mb-3 position-relative" id="priceInput">
                            <label asp-for="Price" class="form-label floating-label">Giá (VNĐ)</label>
                            <input asp-for="Price" type="number" class="form-control" placeholder=" " />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Hình đại diện</label>
                            <div class="input-group">
                                <input type="file" name="thumbnail" class="form-control" accept="image/*" onchange="previewImage(this)" />
                            </div>
                            <small class="text-muted">Khuyến nghị: 800x600px, JPG/PNG</small>
                            <div id="thumbnailPreview" class="mt-2"></div>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Hủy
                    </a>
                    <button type="submit" class="btn btn-custom" onclick="confirmSubmit(event)">
                        <i class="fas fa-save me-2"></i>Tạo khóa học
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <style>
        .admin-card {
            border-radius: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .admin-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
        }
        .form-control, .form-select, .form-control-file {
            border-radius: 8px;
            padding: 10px 15px;
        }
        .input-group-text {
            border-radius: 8px 0 0 8px;
            background: #f8f9fa;
        }

        .form-control:focus + .floating-label,
        .form-control:not(:placeholder-shown) + .floating-label,
        textarea.form-control:not(:empty) + .floating-label {
            top: 0;
            font-size: 0.75rem;
            background: #fff;
            padding: 0 5px;
            transform: translateY(-100%);
        }
        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }
        .text-danger {
            font-size: 0.85rem;
            margin-top: 5px;
            display: block;
        }
        [data-theme="dark"] .admin-card {
            background: #2d3748;
            color: #e5e7eb;
        }
        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select,
        [data-theme="dark"] .input-group-text {
            background: #4a5568;
            color: #e5e7eb;
            border-color: #6b7280;
        }
        [data-theme="dark"] .floating-label {
            color: #d1d5db;
        }
        [data-theme="dark"] .form-control:focus + .floating-label,
        [data-theme="dark"] .form-control:not(:placeholder-shown) + .floating-label,
        [data-theme="dark"] textarea.form-control:not(:empty) + .floating-label {
            background: #4a5568;
        }
        [data-theme="dark"] .text-danger {
            color: #f87171;
        }
    </style>
    <script>
        AOS.init({ duration: 800, once: true });

        if ($('.text-danger').filter(function() { return $(this).text().trim(); }).length > 0) {
            $('#validationSummary').removeClass('d-none');
        }

        $('#isFree').change(function() {
            if ($(this).is(':checked')) {
                $('#priceInput').hide();
                $('#Price').val(0);
            } else {
                $('#priceInput').show();
            }
        });

        if ($('#isFree').is(':checked')) {
            $('#priceInput').hide();
        }
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#thumbnailPreview').html('<img src="' + e.target.result + '" class="img-fluid rounded" style="max-height: 200px;">');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function confirmSubmit(event) {
            event.preventDefault();
            Swal.fire({
                title: 'Tạo khóa học mới?',
                text: 'Bạn có chắc muốn tạo khóa học này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: '<i class="fas fa-save"></i> Tạo',
                cancelButtonText: '<i class="fas fa-times"></i> Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#createCourseForm').submit();
                }
            });
        }
    </script>
}