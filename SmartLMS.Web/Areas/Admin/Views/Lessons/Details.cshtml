@model Lesson

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"></h1>
    <div>
        <a onclick="showpopup('Sửa bài học', '/Admin/Lessons/Edit/@Model.Id'); return false;" class="btn btn-warning">
            <i class="fas fa-edit fa-sm text-white-50"></i> Sửa bài học
        </a>
        <form method="post" asp-action="TogglePublish" class="d-inline" id="hideOrPublishLessonForm" data-lesson-id="@Model.Id" data-course-id="@Model.CourseId">
            <input type="hidden" name="id" value="@Model.Id" />
            @if (Model.IsPublished)
            {
                <button type="submit" class="btn btn-secondary btnHideLesson" data-type="0">
                    <i class="fas fa-eye-slash fa-sm text-white-50"></i> Ẩn bài học
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-success" data-type="1">
                    <i class="fas fa-eye fa-sm text-white-50"></i> Xuất bản
                </button>
            }
        </form>
        <a onclick="showpopup('Quản lý bài học', '@Url.Action("Index", new { courseId = Model.CourseId })'); return false;" class="btn btn-secondary">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Quay lại
        </a>
        <button type="button" class="btn btn-danger" id="deleteLesson" data-lesson-id="@Model.Id" data-course-id="@Model.CourseId">
            <i class="fas fa-trash fa-sm text-white-50"></i> Xóa
        </button>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Lesson Content -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Thông tin bài học</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <h4>@Model.Title</h4>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-secondary">Bài @Model.OrderIndex</span>
                        <span class="badge bg-info">
                            <i class="fas fa-clock me-1"></i>
                            @TimeSpan.FromSeconds(Model.Duration).ToString(@"mm\:ss")
                        </span>
                        @if (Model.IsPreview)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-eye me-1"></i>Xem trước
                            </span>
                        }
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check me-1"></i>Đã xuất bản
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                <i class="fas fa-eye-slash me-1"></i>Nháp
                            </span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <div class="mb-4">
                        <h5>Video bài học:</h5>
                        <video controls class="w-100" style="max-height: 500px;">
                            <source src="@Model.VideoUrl" type="video/mp4">
                            Trình duyệt của bạn không hỗ trợ video HTML5.
                        </video>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        Bài học này chưa có video. Bạn có thể thêm video khi chỉnh sửa bài học.
                    </div>
                }

                <div>
                    <h5>Nội dung bài học:</h5>
                    <div class="content">
                        @Html.Raw(Model.Content.Replace("\n", "<br>"))
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Course Info -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Thông tin khóa học</h6>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Course.Thumbnail))
                {
                    <img src="@Model.Course.Thumbnail" alt="@Model.Course.Title" class="img-fluid rounded mb-3">
                }
                <h6>@Model.Course.Title</h6>
                <p class="small text-muted mb-2">@Model.Course.Category.Name</p>
                <p class="small">
                    <strong>Giảng viên:</strong> @Model.Course.Instructor.FullName
                </p>
            </div>
        </div>

        <!-- Lesson Stats -->
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Thống kê</h6>
            </div>
            <div class="card-body">
                <table class="table table-borderless table-sm">
                    <tr>
                        <td><strong>Thời lượng:</strong></td>
                        <td>@TimeSpan.FromSeconds(Model.Duration).ToString(@"mm\:ss")</td>
                    </tr>
                    <tr>
                        <td><strong>Thứ tự:</strong></td>
                        <td>Bài @Model.OrderIndex</td>
                    </tr>
                    <tr>
                        <td><strong>Ngày tạo:</strong></td>
                        <td>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <td><strong>Trạng thái:</strong></td>
                        <td>
                            @if (Model.IsPublished)
                            {
                                <span class="badge bg-success">Đã xuất bản</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Nháp</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Xem trước:</strong></td>
                        <td>
                            @if (Model.IsPreview)
                            {
                                <span class="badge bg-success">Có</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Không</span>
                            }
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteLesson() {
            if (confirm('Bạn có chắc muốn xóa bài học này? Hành động này không thể hoàn tác.')) {
                const form = $('<form>', {
                    'method': 'POST',
                    'action': '@Url.Action("Delete")'
                }).append($('<input>', {
                    'name': 'id',
                    'value': '@Model.Id',
                    'type': 'hidden'
                })).append($('<input>', {
                    'name': '__RequestVerificationToken',
                    'value': $('input[name="__RequestVerificationToken"]').val(),
                    'type': 'hidden'
                }));

                $('body').append(form);
                form.submit();
            }
        }
    </script>
}