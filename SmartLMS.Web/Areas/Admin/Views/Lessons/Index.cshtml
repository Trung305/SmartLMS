@model LessonIndexViewModel

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <p class="text-muted mb-0">
            Khóa học: <strong>@Model.Course.Title</strong>
        </p>
    </div>
</div>

<!-- Content Tabs Card -->
<div id="lessonsCard" class="card shadow mb-4">
    <div class="card-header py-3 bg-white">
        <ul class="nav nav-tabs card-header-tabs" id="contentTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="lessons-tab" data-bs-toggle="tab" data-bs-target="#lessons-content" type="button" role="tab">
                    <i class="fas fa-video me-2"></i>Bài học (<span id="lessonCount">0</span>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="quizzes-tab" data-bs-toggle="tab" data-bs-target="#quizzes-content" type="button" role="tab">
                    <i class="fas fa-file-alt me-2"></i>Bài kiểm tra (<span id="quizCount">0</span>)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content" id="contentTabsContent">
            <!-- Lessons Tab -->
            <div class="tab-pane fade show active" id="lessons-content" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <a onclick="showpopup('Thêm bài học', '@Url.Action("Create", new { courseId = Model.Course.Id })'); return false;" class="btn btn-primary">
                        <i class="fas fa-plus fa-sm text-white-50"></i> Thêm bài học mới
                    </a>
                    @if (Model.Lessons.Any())
                    {
                        <button type="button" class="btn btn-sm btn-info" id="enableReorder">
                            <i class="fas fa-sort me-1"></i>Sắp xếp lại
                        </button>
                    }
                </div>
                @if (Model.Lessons.Any())
                {
                    <div id="lessonsList" class="list-group custom-list scrollable-list" data-course-id="@Model.Course.Id">
                    </div>
                    <div id="reorderButtons" class="mt-3" style="display: none;">
                        <button type="button" class="btn btn-success" id="saveOrder">
                            <i class="fas fa-save me-2"></i>Lưu thứ tự
                        </button>
                        <button type="button" class="btn btn-secondary" id="cancelReorder">
                            <i class="fas fa-times me-2"></i>Hủy
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center py-5" id="emptyState">
                        <i class="fas fa-video fa-3x text-muted mb-3"></i>
                        <h5>Chưa có bài học nào</h5>
                        <p class="text-muted">Nhấn nút "Thêm bài học mới" để tạo bài học đầu tiên.</p>
                    </div>
                }
            </div>

            <!-- Quizzes Tab -->
            <div class="tab-pane fade" id="quizzes-content" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">Danh sách bài kiểm tra</h6>
                    <a onclick="showpopup('Thêm bài kiểm tra', '@Url.Action("Upsert","Quizzes", new { courseId = Model.Course.Id })'); return false;" class="btn btn-success">
                        <i class="fas fa-file-alt fa-sm me-1"></i> Tạo bài kiểm tra
                    </a>
                </div>

                <div class="list-group custom-list scrollable-list" id="quizzesList">
                </div>

                <div class="text-center py-5" id="emptyQuizzesState" style="display: none;">
                    <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                    <h5>Chưa có bài kiểm tra nào</h5>
                    <p class="text-muted">Nhấn nút "Tạo bài kiểm tra" để tạo bài kiểm tra đầu tiên.</p>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .scrollable-list {
        max-height: 500px;
        overflow-y: auto;
        padding: 0;
    }

        .scrollable-list::-webkit-scrollbar {
            width: 8px;
        }

        .scrollable-list::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .scrollable-list::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 10px;
        }

            .scrollable-list::-webkit-scrollbar-thumb:hover {
                background: #555;
            }

    .quiz-item {
        transition: all 0.3s ease;
    }

        .quiz-item:hover {
            background-color: #f8f9fa;
        }

    .quiz-type-badge {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
    }

    .lesson-quiz-connection {
        border-left: 3px solid #28a745;
        padding-left: 1rem;
        margin-top: 0.5rem;
        background-color: #f0f8f4;
    }

    .custom-list .list-group-item {
        background-color: #ffffff !important;
        border: 1px solid #dee2e6 !important;
        border-radius: 0.75rem !important;
        margin-bottom: 1rem !important;
        padding: 1.25rem 1.5rem !important;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
        transition: all 0.3s ease;
    }

        .custom-list .list-group-item:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
            transform: translateY(-3px);
            border-color: #4e73df !important;
        }

    .custom-list .btn-sm {
        padding: 0.35rem 0.75rem;
        font-size: 0.875rem;
    }

    #lessonsList .drag-handle {
        color: #adb5bd;
        font-size: 1.3rem;
    }

    
</style>