@model UserCreateEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4" data-aos="fade-down">
        <h1 class="h3 mb-0 text-primary"><i class="fas fa-user-edit me-2"></i>Chỉnh sửa người dùng</h1>
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info me-2">
                <i class="fas fa-eye me-2"></i>Xem chi tiết
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Edit Form -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card admin-card shadow-sm border-0 mb-4" data-aos="fade-up">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="m-0 font-weight-bold"><i class="fas fa-user-edit me-2"></i>Thông tin người dùng</h6>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Edit" id="editUserForm">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show d-none" role="alert" id="validationSummary">
                            <i class="fas fa-exclamation-circle me-2"></i>Vui lòng kiểm tra các lỗi bên dưới
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="FirstName" class="form-label floating-label">Họ</label>
                                    <input asp-for="FirstName" class="form-control" placeholder=" " />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="LastName" class="form-label floating-label">Tên</label>
                                    <input asp-for="LastName" class="form-control" placeholder=" " />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="Email" class="form-label floating-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder=" " />
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SelectedRole" class="form-label">Vai trò</label>
                            <select asp-for="SelectedRole" class="form-select">
                                <option value="">-- Chọn vai trò --</option>
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role" selected="@(Model.SelectedRole == role)">@role</option>
                                }
                            </select>
                            <span asp-validation-for="SelectedRole" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" id="isActive" />
                                <label asp-for="IsActive" class="form-check-label">Tài khoản đang hoạt động</label>
                            </div>
                        </div>

                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Lưu ý:</strong> Để thay đổi mật khẩu, sử dụng form "Đặt lại mật khẩu" bên dưới.
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                            <button type="submit" class="btn btn-custom" onclick="confirmEdit(event)">
                                <i class="fas fa-save me-2"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Reset Password Card -->
            <div class="card admin-card shadow-sm border-0" data-aos="fade-up" data-aos-delay="100">
                <div class="card-header bg-warning text-white py-3">
                    <h6 class="m-0 font-weight-bold"><i class="fas fa-key me-2"></i>Đặt lại mật khẩu</h6>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="ResetPassword" id="resetPasswordForm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3 position-relative">
                            <label for="newPassword" class="form-label floating-label">Mật khẩu mới</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder=" " minlength="6" required />
                            </div>
                            <small class="text-muted">Mật khẩu phải có ít nhất 6 ký tự</small>
                        </div>
                        <button type="submit" class="btn btn-custom btn-warning" onclick="confirmResetPassword(event)">
                            <i class="fas fa-sync me-2"></i>Đặt lại mật khẩu
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <style>
        .admin-card {
            border-radius: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .admin-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
            }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 10px 15px;
        }

        .input-group-text {
            border-radius: 8px 0 0 8px;
            background: #f8f9fa;
        }


        .form-control:focus + .floating-label,
        .form-control:not(:placeholder-shown) + .floating-label {
            top: 0;
            font-size: 0.75rem;
            background: #fff;
            padding: 0 5px;
            transform: translateY(-100%);
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }

        .text-danger {
            font-size: 0.85rem;
            margin-top: 5px;
            display: block;
        }

        .btn-warning {
            background: linear-gradient(45deg, #f6c107, #dc3545);
            border: none;
        }

            .btn-warning:hover {
                background: linear-gradient(45deg, #e0a800, #c82333);
            }

        [data-theme="dark"] .admin-card {
            background: #2d3748;
            color: #e5e7eb;
        }

        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select,
        [data-theme="dark"] .input-group-text {
            background: #4a5568;
            color: #e5e7eb;
            border-color: #6b7280;
        }

        [data-theme="dark"] .floating-label {
            color: #d1d5db;
        }

        [data-theme="dark"] .form-control:focus + .floating-label,
        [data-theme="dark"] .form-control:not(:placeholder-shown) + .floating-label {
            background: #4a5568;
        }

        [data-theme="dark"] .text-danger {
            color: #f87171;
        }

        [data-theme="dark"] .alert-info {
            background: #2b6cb0;
            color: #e5e7eb;
        }
    </style>
    <script>
        // Initialize AOS
        AOS.init({ duration: 800, once: true });

        // Show validation summary if errors exist
        if ($('.text-danger').filter(function() { return $(this).text().trim(); }).length > 0) {
            $('#validationSummary').removeClass('d-none');
        }

        // Confirm edit submit
        function confirmEdit(event) {
            event.preventDefault();
            Swal.fire({
                title: 'Lưu thay đổi?',
                text: 'Bạn có chắc muốn lưu các thay đổi cho người dùng này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: '<i class="fas fa-save"></i> Lưu',
                cancelButtonText: '<i class="fas fa-times"></i> Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#editUserForm').submit();
                }
            });
        }

        // Confirm reset password
        function confirmResetPassword(event) {
            event.preventDefault();
            Swal.fire({
                title: 'Đặt lại mật khẩu?',
                text: 'Mật khẩu mới sẽ được áp dụng cho người dùng này. Bạn có chắc?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f6c107',
                cancelButtonColor: '#d33',
                confirmButtonText: '<i class="fas fa-sync"></i> Đặt lại',
                cancelButtonText: '<i class="fas fa-times"></i> Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#resetPasswordForm').submit();
                }
            });
        }
    </script>
}