@model UserCreateEditViewModel
@{
    ViewData["Title"] = "Tạo người dùng mới";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4" data-aos="fade-down">
        <h1 class="h3 mb-0 text-primary"><i class="fas fa-user-plus me-2"></i>Tạo người dùng mới</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <!-- Form -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card admin-card shadow-sm border-0" data-aos="fade-up">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="m-0 font-weight-bold"><i class="fas fa-user-edit me-2"></i>Thông tin người dùng</h6>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Create" id="createUserForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show d-none" role="alert" id="validationSummary">
                            <i class="fas fa-exclamation-circle me-2"></i>Vui lòng kiểm tra các lỗi bên dưới
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="FirstName" class="form-label floating-label">Họ</label>
                                    <input asp-for="FirstName" class="form-control" placeholder=" " />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="LastName" class="form-label floating-label">Tên</label>
                                    <input asp-for="LastName" class="form-control" placeholder=" " />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 position-relative">
                            <label asp-for="Email" class="form-label floating-label">Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder=" " />
                            </div>
                            <span asp-validation-for="Email" class="text-danger"></span>
                            <small class="text-muted">Email sẽ được dùng làm tên đăng nhập</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="Password" class="form-label floating-label">Mật khẩu</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                        <input asp-for="Password" class="form-control" placeholder=" " />
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3 position-relative">
                                    <label asp-for="ConfirmPassword" class="form-label floating-label">Xác nhận mật khẩu</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                        <input asp-for="ConfirmPassword" class="form-control" placeholder=" " />
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SelectedRole" class="form-label">Vai trò</label>
                            <select asp-for="SelectedRole" class="form-select">
                                <option value="">-- Chọn vai trò --</option>
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                            <span asp-validation-for="SelectedRole" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" id="isActive" />
                                <label asp-for="IsActive" class="form-check-label">Kích hoạt tài khoản ngay</label>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                            <button type="submit" class="btn btn-custom" onclick="confirmSubmit(event)">
                                <i class="fas fa-user-plus me-2"></i>Tạo người dùng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <style>
        .admin-card {
            border-radius: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .admin-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
            }

        .form-control, .form-select {
            border-radius: 8px;
            padding: 10px 15px;
        }

        .input-group-text {
            border-radius: 8px 0 0 8px;
            background: #f8f9fa;
        }

/*         .floating-label {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            transition: all 0.2s ease;
            color: #6c757d;
            pointer-events: none;
            font-size: 1rem;
        } */

        .form-control:focus + .floating-label,
        .form-control:not(:placeholder-shown) + .floating-label {
            top: 0;
            font-size: 0.75rem;
            background: #fff;
            padding: 0 5px;
            transform: translateY(-100%);
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }

        .text-danger {
            font-size: 0.85rem;
            margin-top: 5px;
            display: block;
        }

        [data-theme="dark"] .admin-card {
            background: #2d3748;
            color: #e5e7eb;
        }

        [data-theme="dark"] .form-control,
        [data-theme="dark"] .form-select,
        [data-theme="dark"] .input-group-text {
            background: #4a5568;
            color: #e5e7eb;
            border-color: #6b7280;
        }

        [data-theme="dark"] .floating-label {
            color: #d1d5db;
        }

        [data-theme="dark"] .form-control:focus + .floating-label,
        [data-theme="dark"] .form-control:not(:placeholder-shown) + .floating-label {
            background: #4a5568;
        }

        [data-theme="dark"] .text-danger {
            color: #f87171;
        }
    </style>
    <script>
        // Initialize AOS
        AOS.init({ duration: 800, once: true });

        // Show validation summary if errors exist
        if ($('.text-danger').filter(function() { return $(this).text().trim(); }).length > 0) {
            $('#validationSummary').removeClass('d-none');
        }

        // Confirm submit with SweetAlert2
        function confirmSubmit(event) {
            event.preventDefault();
            Swal.fire({
                title: 'Tạo người dùng mới?',
                text: 'Bạn có chắc muốn tạo người dùng này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: '<i class="fas fa-user-plus"></i> Tạo',
                cancelButtonText: '<i class="fas fa-times"></i> Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#createUserForm').submit();
                }
            });
        }
    </script>
}