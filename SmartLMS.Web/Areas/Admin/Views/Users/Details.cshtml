@using SmartLMS.Core.Enums
@using SmartLMS.Web.Areas.Admin.Models
@model AdminUserDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết người dùng - " + Model.UserWithRoles.User.FullName;
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4" data-aos="fade-down">
        <h1 class="h3 mb-0 text-primary"><i class="fas fa-user me-2"></i>Chi tiết người dùng</h1>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
            <a href="@Url.Action("Edit", new { id = Model.UserWithRoles.User.Id })" class="btn btn-warning">
                <i class="fas fa-edit fa-sm text-white-50"></i> Chỉnh sửa
            </a>
            <form method="post" asp-action="ToggleActive" class="d-inline">
                <input type="hidden" name="id" value="@Model.UserWithRoles.User.Id" />
                <button type="submit" class="btn btn-@(Model.UserWithRoles.User.IsActive ? "warning" : "success") btn-custom" onclick="confirmToggle(event, '@Model.UserWithRoles.User.FullName', '@(Model.UserWithRoles.User.IsActive ? "vô hiệu hóa" : "kích hoạt")')">
                    <i class="fas fa-@(Model.UserWithRoles.User.IsActive ? "ban" : "check") me-2"></i>@(Model.UserWithRoles.User.IsActive ? "Vô hiệu hóa" : "Kích hoạt")
                </button>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <!-- User Profile Card -->
            <div class="card admin-card shadow-sm border-0 mb-4" data-aos="fade-up">
                <div class="card-body text-center p-4">
                    <div class="bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                        @Model.UserWithRoles.User.FirstName.Substring(0, 1)@Model.UserWithRoles.User.LastName.Substring(0, 1)
                    </div>
                    <h4 class="mb-1 text-truncate" style="max-width: 250px;">@Model.UserWithRoles.User.FullName</h4>
                    <p class="text-muted mb-3">@Model.UserWithRoles.User.Email</p>
                    <div class="mb-3">
                        @foreach (var role in Model.UserWithRoles.Roles)
                        {
                            <span class="badge bg-@(GetRoleBadgeClass(role)) me-1">@role</span>
                        }
                    </div>
                    @if (Model.UserWithRoles.User.IsActive)
                    {
                        <span class="badge bg-success fs-6"><i class="fas fa-check me-1"></i>Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6"><i class="fas fa-ban me-1"></i>Ngừng hoạt động</span>
                    }
                </div>
            </div>

            <!-- Role Management -->
            <div class="card admin-card shadow-sm border-0 mb-4" data-aos="fade-up" data-aos-delay="100">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="m-0 font-weight-bold"><i class="fas fa-user-tag me-2"></i>Quản lý vai trò</h6>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="ChangeRole" id="changeRoleForm">
                        <input type="hidden" name="id" value="@Model.UserWithRoles.User.Id" />
                        <div class="mb-3">
                            <label class="form-label">Chọn vai trò mới:</label>
                            <select name="newRole" class="form-select">
                                <option value="">-- Chọn vai trò --</option>
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role" selected="@Model.UserWithRoles.Roles.Contains(role)">@role</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-custom w-100" onclick="confirmChangeRole(event, '@Model.UserWithRoles.User.FullName')">
                            <i class="fas fa-user-tag me-2"></i>Cập nhật vai trò
                        </button>
                    </form>
                </div>
            </div>

            <!-- User Info -->
            <div class="card admin-card shadow-sm border-0" data-aos="fade-up" data-aos-delay="200">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="m-0 font-weight-bold"><i class="fas fa-info-circle me-2"></i>Thông tin tài khoản</h6>
                </div>
                <div class="card-body p-4">
                    <table class="table table-borderless table-sm">
                        <tr>
                            <td><strong>Username:</strong></td>
                            <td>@Model.UserWithRoles.User.UserName</td>
                        </tr>
                        <tr>
                            <td><strong>Email:</strong></td>
                            <td>
                                @Model.UserWithRoles.User.Email
                                @if (Model.UserWithRoles.User.EmailConfirmed)
                                {
                                    <i class="fas fa-check-circle text-success ms-1" title="Email đã xác thực"></i>
                                }
                                else
                                {
                                    <i class="fas fa-exclamation-circle text-warning ms-1" title="Email chưa xác thực"></i>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Ngày tham gia:</strong></td>
                            <td>@Model.UserWithRoles.User.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr>
                            <td><strong>Lần đăng nhập cuối:</strong></td>
                            <td>
                                @if (Model.UserWithRoles.User.LastLoginDate.HasValue)
                                {
                                    @Model.UserWithRoles.User.LastLoginDate.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Chưa đăng nhập</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            @if (Model.UserWithRoles.Roles.Contains("Student") && Model.RecentEnrollments != null)
            {
                <!-- Student Enrollments -->
                <div class="card admin-card shadow-sm border-0 mb-4" data-aos="fade-up">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="m-0 font-weight-bold"><i class="fas fa-book me-2"></i>Khóa học đã đăng ký (@Model.RecentEnrollments.Count)</h6>
                    </div>
                    <div class="card-body p-4">
                        @if (Model.RecentEnrollments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-modern table-hover">
                                    <thead>
                                        <tr>
                                            <th>Khóa học</th>
                                            <th>Tiến độ</th>
                                            <th>Ngày đăng ký</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var enrollment in Model.RecentEnrollments)
                                        {
                                            <tr>
                                                <td>
                                                    <h6 class="mb-1 text-truncate" style="max-width: 200px;">@enrollment.Course?.Title</h6>
                                                    <small class="text-muted">@enrollment.Course?.Category.Name</small>
                                                </td>
                                                <td>
                                                    <div class="progress" style="height: 20px; border-radius: 10px;">
                                                        <div class="progress-bar bg-@(enrollment.Status == EnrollmentStatus.Completed ? "success" : enrollment.Status == EnrollmentStatus.Active ? "info" : "secondary")"
                                                             role="progressbar" style="width: @(enrollment.Progress)%;"
                                                             aria-valuenow="@enrollment.Progress" aria-valuemin="0" aria-valuemax="100">
                                                            @enrollment.Progress.ToString("F1")%
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@enrollment.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    @if (enrollment.Status == EnrollmentStatus.Active)
                                                    {
                                                        <span class="badge bg-success">Đang học</span>
                                                    }
                                                    else if (enrollment.Status == EnrollmentStatus.Completed)
                                                    {
                                                        <span class="badge bg-primary">Hoàn thành</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@enrollment.Status</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-book fa-2x text-muted mb-2"></i>
                                <p class="text-muted">Chưa đăng ký khóa học nào</p>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.UserWithRoles.Roles.Contains("Instructor") && Model.CreatedCourses != null)
            {
                <!-- Instructor Courses -->
                <div class="card admin-card shadow-sm border-0" data-aos="fade-up" data-aos-delay="100">
                    <div class="card-header bg-primary text-white py-3">
                        <h6 class="m-0 font-weight-bold"><i class="fas fa-chalkboard-teacher me-2"></i>Khóa học đã tạo (@Model.CreatedCourses.Count)</h6>
                    </div>
                    <div class="card-body p-4">
                        @if (Model.CreatedCourses.Any())
                        {
                            <div class="row">
                                @foreach (var course in Model.CreatedCourses)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card h-100 shadow-sm border-0 hover-effect">
                                            @if (!string.IsNullOrEmpty(course.Thumbnail))
                                            {
                                                <img src="@course.Thumbnail" class="card-img-top" alt="@course.Title" style="height: 150px; object-fit: cover; border-radius: 10px 10px 0 0;">
                                            }
                                            else
                                            {
                                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 150px; border-radius: 10px 10px 0 0;">
                                                    <i class="fas fa-image fa-2x text-muted"></i>
                                                </div>
                                            }
                                            <div class="card-body">
                                                <h6 class="card-title text-truncate" style="max-width: 250px;">@course.Title</h6>
                                                <p class="card-text small text-muted text-truncate" style="max-width: 250px;">@course.ShortDescription</p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        @if (course.Status == CourseStatus.Published)
                                                        {
                                                            <span class="badge bg-success">Xuất bản</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning">Nháp</span>
                                                        }
                                                    </div>
                                                    <small class="text-muted">@course.TotalEnrollments học viên</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-chalkboard-teacher fa-2x text-muted mb-2"></i>
                                <p class="text-muted">Chưa tạo khóa học nào</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    public string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "Admin" => "danger",
            "Instructor" => "warning",
            "Student" => "primary",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        .admin-card {
            border-radius: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .admin-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
            }

        .table-modern th {
            background: #f8f9fa;
            border: none;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            padding: 15px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .table-modern td {
            vertical-align: middle;
            padding: 15px;
            border-color: #dee2e6;
        }

        .table-modern tbody tr:hover {
            background: #f8f9fa;
        }

        .hover-effect:hover {
            background: #f8f9fa;
            border-radius: 10px;
        }

        .form-select {
            border-radius: 8px;
            padding: 10px 15px;
        }

        [data-theme="dark"] .admin-card {
            background: #2d3748;
            color: #e5e7eb;
        }

        [data-theme="dark"] .table-modern th {
            background: #4a5568;
            color: #e5e7eb;
        }

        [data-theme="dark"] .table-modern tbody tr:hover {
            background: #4a5568;
        }

        [data-theme="dark"] .table-modern td {
            border-color: #6b7280;
        }

        [data-theme="dark"] .hover-effect:hover {
            background: #4a5568;
        }
    </style>
    <script>
        // Initialize AOS
        AOS.init({ duration: 800, once: true });

        // Confirm toggle active
        function confirmToggle(event, fullName, action) {
            event.preventDefault();
            Swal.fire({
                title: `Bạn có chắc muốn ${action} "${fullName}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: action === 'vô hiệu hóa' ? '#f6c107' : '#28a745',
                cancelButtonColor: '#d33',
                confirmButtonText: `<i class="fas fa-${action === 'vô hiệu hóa' ? 'ban' : 'check'}"></i> ${action.charAt(0).toUpperCase() + action.slice(1)}`,
                cancelButtonText: '<i class="fas fa-times"></i> Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    event.target.closest('form').submit();
                }
            });
        }

        // Confirm change role
        function confirmChangeRole(event, fullName) {
            event.preventDefault();
            const newRole = document.querySelector('#changeRoleForm select').value;
            if (!newRole) {
                Swal.fire({
                    title: 'Lỗi',
                    text: 'Vui lòng chọn một vai trò mới!',
                    icon: 'error',
                    confirmButtonColor: '#3085d6'
                });
                return;
            }
            Swal.fire({
                title: `Cập nhật vai trò cho "${fullName}"?`,
                text: `Vai trò mới: ${newRole}`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: '<i class="fas fa-user-tag"></i> Cập nhật',
                cancelButtonText: '<i class="fas fa-times"></i> Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('changeRoleForm').submit();
                }
            });
        }
    </script>
}