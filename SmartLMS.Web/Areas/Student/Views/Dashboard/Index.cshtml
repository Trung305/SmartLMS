@using SmartLMS.Web.Areas.Student.Models
@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Học viên";
    Layout = "_StudentLayout";
}

<div class="d-flex align-items-center justify-content-between mb-4" data-aos="fade-down">
    <h1 class="h3 mb-0 text-primary">
        <i class="fas fa-tachometer-alt me-2"></i>Chào mừng trở lại, @Model.Student.FirstName!
    </h1>
</div>

<!-- Progress Overview -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stats-card primary shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Tổng khóa học</h6>
                        <h2 class="fw-bold mb-0">@Model.TotalEnrollments</h2>
                    </div>
                    <div class="fs-1 text-primary">📚</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stats-card warning shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Đang học</h6>
                        <h2 class="fw-bold mb-0">@Model.InProgressCourses</h2>
                    </div>
                    <div class="fs-1 text-warning">⏳</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stats-card success shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Hoàn thành</h6>
                        <h2 class="fw-bold mb-0">@Model.CompletedCourses</h2>
                    </div>
                    <div class="fs-1 text-success">✅</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stats-card info shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Chuỗi ngày học</h6>
                        <h2 class="fw-bold mb-0">12@* @Model.CurrentStreak *@ 🔥</h2>
                    </div>
                    <div class="fs-1 text-info">📅</div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row g-4 mb-4">
    <!-- Tiến độ tổng quan -->
    <div class="col-lg-8">
        <div class="card shadow-lg border-0 h-100" style="background: linear-gradient(135deg, #f8f9fc 0%, #e9ecef 100%);">
            <div class="card-header bg-gradient-primary text-white border-0">
                <h5 class="mb-0 fw-bold">Tiến Độ Tổng Quan</h5>
            </div>
            <div class="card-body p-4">
                <canvas id="progressChart" height="220"></canvas>
            </div>
        </div>
    </div>

    <!-- Thời gian học -->
    <div class="col-lg-4">
        <div class="card shadow-lg border-0 h-100" style="background: linear-gradient(135deg, #f8f9fc 0%, #e3f2fd 100%);">
            <div class="card-header bg-gradient-info text-white border-0">
                <h5 class="mb-0 fw-bold">Thời Gian Học</h5>
            </div>
            <div class="card-body p-4">
                <div class="text-center mb-3">
                    @{
                        var hours = Model.TotalLearningTime / 60;
                        var minutes = Model.TotalLearningTime % 60;
                    }
                    <h1 class="display-5 fw-bold text-primary mb-0">@hours<span class="h4">h</span> @minutes<span class="h4">m</span></h1>
                    <p class="text-muted small mb-0">Tổng thời gian học</p>
                </div>
                <canvas id="timeChart" height="140"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Hoạt động và thành tựu -->
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-lg border-0 rounded-3 overflow-hidden" style="background: #ffffff; border: 1px solid #dee2e6;">
            <div class="card-header bg-gradient-primary text-white border-0 py-3 px-4">
                <h5 class="mb-0 fw-bold fs-5">Hoạt Động Gần Đây</h5>
            </div>
            <div class="card-body p-0" style="max-height: 280px; overflow-y: auto;">
                @if (Model.RecentActivity.Any())
                {
                    @foreach (var activity in Model.RecentActivity.Take(10))
                    {
                        var isCompleted = activity.IsCompleted;
                        <div class="p-4 border-bottom @(isCompleted ? "border-success" : "border-primary")"
                             style="border-left: 4px solid @(isCompleted ? "#1cc88a" : "#4e73df"); background: #fff; transition: all .2s;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-fill">
                                    <strong class="d-block text-dark text-truncate" style="max-width: 220px;">
                                        @activity.Lesson.Course.Title
                                    </strong>
                                    <p class="small text-muted mb-1">@activity.Lesson.Title</p>
                                    <span class="badge @(isCompleted ? "bg-success" : "bg-primary") fw-semibold">
                                        @(isCompleted ? "Hoàn thành" : "Đã xem")
                                    </span>
                                </div>
                                <small class="text-muted text-nowrap ms-3">
                                    @(isCompleted
                                        ? activity.CompletedDate?.ToString("HH:mm, dd/MM")
                                        : activity.LastAccessDate.ToString("HH:mm, dd/MM"))
                                </small>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <p class="mb-0">Chưa có hoạt động nào</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Thành tựu -->
    <div class="col-lg-6">
        <div class="card shadow-lg border-0 rounded-3 overflow-hidden" style="background: #ffffff; border: 1px solid #dee2e6;">
            <div class="card-header bg-gradient-warning text-white border-0 py-3 px-4">
                <h5 class="mb-0 fw-bold fs-5">Thành Tựu</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 text-center">
                    @{
                        var achievements = new[]
                        {
                    new { Icon = "Target", Title = "Bước Đầu Tiên", Desc = "Đăng ký khóa đầu", Unlocked = true },
                    new { Icon = "Trophy", Title = "Hoàn Thành Khóa", Desc = "Hoàn thành khóa đầu", Unlocked = true },
                    new { Icon = "Book", Title = "Học Viên Chăm Chỉ", Desc = "Chuỗi 7 ngày", Unlocked = true },
                    new { Icon = "Crown", Title = "Bậc Thầy", Desc = "Hoàn thành 5 khóa", Unlocked = false }
                    };
                    }
                    @foreach (var item in achievements)
                    {
                        <div class="col-6 col-md-3">
                            <div class="achievement-item mx-auto mb-2 @(item.Unlocked ? "" : "locked")">
                                <div class="badge-achievement">@item.Icon</div>
                            </div>
                            <h6 class="mb-1">@item.Title</h6>
                            <small class="text-muted">@item.Desc</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" rel="stylesheet">
    <style>
        .stats-card {
            border-left: 4px solid;
            transition: transform .3s ease;
            border-radius: 12px;
        }

            .stats-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0,0,0,.1);
            }

            .stats-card.primary {
                border-color: #0d6efd;
            }

            .stats-card.success {
                border-color: #198754;
            }

            .stats-card.warning {
                border-color: #ffc107;
            }

            .stats-card.info {
                border-color: #0dcaf0;
            }

        .dashboard-card {
            border-radius: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .dashboard-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            }

        .icon-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            font-size: 1.3rem;
        }

        .course-card {
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

            .course-card:hover {
                transform: translateY(-5px);
            }

        .timeline-item {
            position: relative;
            padding-left: 30px;
        }

        .timeline-icon {
            position: absolute;
            left: 0;
            top: 4px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: .75rem;
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%) !important;
        }

        .bg-gradient-info {
            background: linear-gradient(135deg, #36b9cc 0%, #258391 100%) !important;
        }

        .card.shadow-lg {
            box-shadow: 0 10px 25px rgba(0,0,0,.12) !important;
        }

        .bg-success {
            background-color: #1cc88a !important;
        }

        .bg-info {
            background-color: #36b9cc !important;
        }

        .bg-warning {
            background-color: #f6c23e !important;
        }

        .text-xs {
            font-size: .75rem;
        }

        .course-item {
            transition: background .2s, border-color .2s;
        }

            .course-item:hover {
                background: #f1f3f5 !important;
                border-left-color: #4e73df !important;
            }

        .card.shadow-lg {
            box-shadow: 0 12px 28px rgba(0,0,0,.15) !important;
        }

        .course-item:hover {
            background: #f8f9fc !important;
            border-left: 4px solid #4e73df;
            padding-left: 1.25rem !important;
        }

        .btn-outline-light {
            border-color: rgba(255,255,255,.3);
            color: #fff;
        }

            .btn-outline-light:hover, .btn-check:checked + .btn-outline-light {
                background: rgba(255,255,255,.2);
                border-color: transparent;
            }

        .border-success {
            border-color: #1cc88a !important;
        }

        .border-primary {
            border-color: #4e73df !important;
        }

        .achievement-item:hover .badge-achievement {
            transform: scale(1.15);
        }

        .badge-achievement {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            font-size: 1.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(0,0,0,.2);
            transition: transform .2s;
        }

        .achievement-item.locked .badge-achievement {
            background: #ced4da;
            color: #6c757d;
            opacity: 0.4;
        }

        .card-body::-webkit-scrollbar {
            width: 6px;
        }

        .card-body::-webkit-scrollbar-track {
            background: #f1f3f5;
            border-radius: 10px;
        }

        .card-body::-webkit-scrollbar-thumb {
            background: #a0aec0;
            border-radius: 10px;
        }

            .card-body::-webkit-scrollbar-thumb:hover {
                background: #718096;
            }

        /* Hover item */
        .card-body > div:hover {
            background: #f8f9fc !important;
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0"></script>
    <script>
        AOS.init({ duration: 800, once: true });

        // Biểu đồ tròn nhỏ gọn
        new Chart(document.getElementById('progressChart'), {
            type: 'doughnut',
            data: {
                labels: ['Hoàn thành', 'Đang học', 'Chưa bắt đầu'],
                datasets: [{
                    data: [@Model.CompletedCourses, @Model.InProgressCourses, @Model.TotalEnrollments - @Model.CompletedCourses - @Model.InProgressCourses],
                    backgroundColor: ['#1cc88a', '#ffc107', '#e9ecef'],
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 15, font: { size: 11 } } },
                    title: { display: true, text: '@Model.OverallProgress.ToString("F1")% hoàn thành', font: { size: 14 } }
                }
            }
        });

        // Biểu đồ cột nhỏ gọn
        new Chart(document.getElementById('timeChart'), {
            type: 'bar',
            data: {
                labels: ['T2','T3','T4','T5','T6','T7','CN'],
                datasets: [{
                    label: 'Phút',
                    data: [30,45,60,40,55,70,50],
                    backgroundColor: '#36b9cc',
                    borderRadius: 4,
                    barThickness: 16
                }]
            },
            options: {
                responsive: true,
                //maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { font: { size: 10 } } },
                    x: { ticks: { font: { size: 10 } } }
                }
            }
        });
            document.querySelectorAll('[name="f"]').forEach(r => r.addEventListener('change', () => {
            const items = document.querySelectorAll('.course-item');
            items.forEach(item => {
                const bar = item.querySelector('.progress-bar');
                const width = bar ? parseInt(bar.style.width) : 0;
                if (r.id === 'all') item.style.display = '';
                else if (r.id === 'doing' && width >= 100) item.style.display = 'none';
                else if (r.id === 'done' && width < 100) item.style.display = 'none';
                else item.style.display = '';
            });
        }));
    </script>
}