@using SmartLMS.Web.Areas.Student.Models
@model LessonViewModel
@{
    ViewData["Title"] = Model.CurrentLesson.Title;
    Layout = "_StudentLayout";
}

<div class="row">
    <!-- Main Content Area -->
    <div class="col-lg-8">
        <!-- Video Player -->
        <div class="card shadow mb-4">
            <div class="card-body p-0">
                @if (!string.IsNullOrEmpty(Model.CurrentLesson.VideoUrl))
                {
                    <video id="lessonVideo" class="w-100" controls style="max-height: 500px;">
                        <source src="@Model.CurrentLesson.VideoUrl" type="video/mp4">
                        Trình duyệt của bạn không hỗ trợ video HTML5.
                    </video>
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
                        <div class="text-center">
                            <i class="fas fa-video fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Video chưa được upload</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Lesson Content -->
        <div class="card shadow">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@Model.CurrentLesson.Title</h4>
                    <div>
                        @if (Model.LessonProgress.IsCompleted)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check me-1"></i>Đã hoàn thành
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                <i class="fas fa-clock me-1"></i>Đang học
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">
                        <i class="fas fa-clock me-1"></i>
                        Thời lượng: @TimeSpan.FromSeconds(Model.CurrentLesson.Duration).ToString(@"mm\:ss")
                        @if (!Model.LessonProgress.IsCompleted)
                        {
                            <span class="ms-3">
                                <i class="fas fa-eye me-1"></i>
                                Đã xem: @TimeSpan.FromSeconds(Model.LessonProgress.WatchedDuration).ToString(@"mm\:ss")
                            </span>
                        }
                    </small>
                </div>

                <div class="lesson-content">
                    @Html.Raw(Model.CurrentLesson.Content.Replace("\n", "<br>"))
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Course Progress -->
        <div class="card shadow mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-chart-pie me-2"></i>Tiến độ khóa học
                </h5>
            </div>
            <div class="card-body text-center">
                <div class="progress-circle mb-3" data-progress="@Model.Enrollment.Progress">
                    <span>@Model.Enrollment.Progress.ToString("F1")%</span>
                </div>
                <p class="text-muted mb-0">
                    @Model.Enrollment.LessonProgress.Count(lp => lp.IsCompleted) / @Model.Enrollment.Course.TotalLessons bài học đã hoàn thành
                </p>
            </div>
        </div>

        <!-- Navigation -->
        <div class="card shadow mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>Điều hướng
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (Model.PreviousLesson != null)
                    {
                        <a href="@Url.Action("Lesson", new { courseId = Model.Enrollment.CourseId, lessonId = Model.PreviousLesson.Id })"
                           class="btn btn-outline-secondary">
                            <i class="fas fa-chevron-left me-2"></i>Bài trước
                        </a>
                    }

                    @if (Model.NextLesson != null)
                    {
                        <a href="@Url.Action("Lesson", new { courseId = Model.Enrollment.CourseId, lessonId = Model.NextLesson.Id })"
                           class="btn btn-primary">
                            Bài tiếp theo<i class="fas fa-chevron-right ms-2"></i>
                        </a>
                    }
                    else if (Model.LessonProgress.IsCompleted)
                    {
                        <div class="text-center">
                            <i class="fas fa-trophy fa-3x text-warning mb-3"></i>
                            <h5>Chúc mừng!</h5>
                            <p>Bạn đã hoàn thành khóa học</p>
                            <a href="@Url.Action("Index", "Dashboard", new { area = "Student" })" class="btn btn-success">
                                <i class="fas fa-home me-2"></i>Về Dashboard
                            </a>
                        </div>
                    }

                    <a href="@Url.Action("CourseProgress", "Dashboard", new { area = "Student", courseId = Model.Enrollment.CourseId })"
                       class="btn btn-outline-info">
                        <i class="fas fa-list-alt me-2"></i>Xem tất cả bài học
                    </a>
                </div>
            </div>
        </div>

        <!-- Course Info -->
        <div class="card shadow">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>Thông tin khóa học
                </h5>
            </div>
            <div class="card-body">
                <h6>@Model.Enrollment.Course.Title</h6>
                <p class="text-muted small mb-2">@Model.Enrollment.Course.ShortDescription</p>
                <ul class="list-unstyled small">
                    <li class="mb-1">
                        <i class="fas fa-user text-primary me-2"></i>
                        @Model.Enrollment.Course.Instructor.FullName
                    </li>
                    <li class="mb-1">
                        <i class="fas fa-tag text-primary me-2"></i>
                        @Model.Enrollment.Course.Category.Name
                    </li>
                    <li class="mb-1">
                        <i class="fas fa-calendar text-primary me-2"></i>
                        Đăng ký: @Model.Enrollment.EnrollmentDate.ToString("dd/MM/yyyy")
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .progress-circle {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto;
        }

            .progress-circle::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                border: 8px solid #e9ecef;
            }

            .progress-circle::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                border: 8px solid transparent;
                border-top-color: #007bff;
                transform: rotate(-90deg);
            }

            .progress-circle span {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                font-size: 1.2rem;
                font-weight: bold;
                color: #007bff;
            }
    </style>
}

@section Scripts {
    <script>
        let video = document.getElementById('lessonVideo');
        let lastUpdateTime = 0;
        let updateInterval = 10; // Update every 10 seconds

        if (video) {
            // Update progress every 10 seconds
            video.addEventListener('timeupdate', function() {
                let currentTime = Math.floor(video.currentTime);

                if (currentTime - lastUpdateTime >= updateInterval || currentTime === 0) {
                    updateProgress(currentTime);
                    lastUpdateTime = currentTime;
                }
            });

            // Save progress when video ends
            video.addEventListener('ended', function() {
                updateProgress(Math.floor(video.duration));
            });

            // Load saved position
            let savedPosition = @Model.LessonProgress.WatchedDuration;
            if (savedPosition > 0 && !@Model.LessonProgress.IsCompleted.ToString().ToLower()) {
                video.currentTime = savedPosition;
            }
        }

        function updateProgress(watchedDuration) {
            fetch('@Url.Action("UpdateProgress", "Learning", new { area = "Student" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({
                    lessonId: '@Model.CurrentLesson.Id',
                    watchedDuration: watchedDuration
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success && data.isCompleted && !@Model.LessonProgress.IsCompleted.ToString().ToLower()) {
                    // Show completion notification
                    showCompletionNotification();

                    // Refresh page to update UI
                    setTimeout(() => {
                        location.reload();
                    }, 2000);
                }
            })
            .catch(error => {
                console.error('Error updating progress:', error);
            });
        }

        function showCompletionNotification() {
            // Simple toast notification
            let toast = $(`
                <div class="toast position-fixed top-0 end-0 m-3" style="z-index: 9999;">
                    <div class="toast-header bg-success text-white">
                        <i class="fas fa-check-circle me-2"></i>
                        <strong class="me-auto">Chúc mừng!</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="toast-body">
                        Bạn đã hoàn thành bài học này!
                    </div>
                </div>
            `);

            $('body').append(toast);
            let toastEl = new bootstrap.Toast(toast[0]);
            toastEl.show();

            // Remove toast after it's hidden
            toast[0].addEventListener('hidden.bs.toast', () => {
                toast.remove();
            });
        }

        // Update progress circle
        $(document).ready(function() {
            let progress = @Model.Enrollment.Progress;
            let circle = $('.progress-circle::after');
            let rotation = (progress / 100) * 360 - 90;

            $('.progress-circle').each(function() {
                let $this = $(this);
                let percent = $this.data('progress');
                let rotation = (percent / 100) * 360;

                $this.find('::after').css({
                    'transform': `rotate(${rotation}deg)`
                });
            });
        });
    </script>
}