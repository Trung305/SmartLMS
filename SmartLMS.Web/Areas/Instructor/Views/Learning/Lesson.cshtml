@using SmartLMS.Web.Areas.Student.Models
@model LessonViewModel
@{
    ViewData["Title"] = Model.CurrentLesson.Title;
    Layout = "_StudentLayout";
}

<div class="row">
    <!-- Main Content Area -->
    <div class="col-lg-8">
        <!-- Video Player -->
        <div class="card shadow-sm mb-4" data-aos="fade-up">
            <div class="card-body p-0">
                @if (!string.IsNullOrEmpty(Model.CurrentLesson.VideoUrl))
                {
                    <video id="lessonVideo" class="w-100" controls preload="metadata" style="max-height: 500px;">
                        <source src="@Model.CurrentLesson.VideoUrl" type="video/mp4">
                        Trình duyệt của bạn không hỗ trợ video HTML5.
                    </video>
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 400px;">
                        <div class="text-center">
                            <i class="fas fa-video-slash fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Video chưa được upload</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Lesson Content -->
        <div class="card shadow-sm" data-aos="fade-up" data-aos-delay="100">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@Model.CurrentLesson.Title</h4>
                    <div>
                        @if (Model.LessonProgress.IsCompleted)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check me-1"></i>Đã hoàn thành
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="fas fa-clock me-1"></i>Đang học
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">
                        <i class="fas fa-clock me-1"></i>
                        Thời lượng: @TimeSpan.FromSeconds(Model.CurrentLesson.Duration).ToString(@"mm\:ss")
                        @if (!Model.LessonProgress.IsCompleted)
                        {
                            <span class="ms-3">
                                <i class="fas fa-eye me-1"></i>
                                Đã xem: @TimeSpan.FromSeconds(Model.LessonProgress.WatchedDuration).ToString(@"mm\:ss")
                            </span>
                        }
                    </small>
                </div>

                <div class="lesson-content">
                    @Html.Raw(Model.CurrentLesson.Content.Replace("\n", "<br>"))
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4 border-0" data-aos="fade-up" data-aos-delay="100">
            <div class="card-header bg-primary text-white py-3 px-4 d-flex align-items-center">
                <i class="fas fa-list-ul me-3"></i>
                <h5 class="mb-0 fw-bold">DANH SÁCH BÀI HỌC</h5>
            </div>

            <div class="p-3 bg-white border-bottom">
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="form-control form-control-sm" placeholder="Tìm bài học..." id="lessonSearch">
                </div>
            </div>
            <div class="list-group list-group-flush" id="lessonList">
                @foreach (var lesson in Model.Lessons.OrderBy(l => l.CreatedDate))
                    {
                        var isCurrent = lesson.Id == Model.CurrentLesson.Id;

                        <a href="@(Url.Action("Lesson", new { courseId = Model.Enrollment.CourseId, lessonId = lesson.Id }))"
                           class="list-group-item list-group-item-action d-flex align-items-center py-3 px-4 border-0 @(isCurrent ? "bg-light-primary" : "")"
                       data-title="@lesson.Title.ToLower()" >
                            <i class="far fa-circle text-muted me-3"></i>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-medium @(isCurrent ? "text-primary" : "")">
                                        @lesson.Title
                                    </span>
                                </div>
                            </div>
                        </a>
                    }
               
            </div>
        </div>

        <div class="card shadow-sm" data-aos="fade-up" data-aos-delay="200">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Thông tin khóa học</h5>
            </div>
            <div class="card-body">
                <h6 class="mb-2">@Model.Enrollment.Course.Title</h6>
                <p class="text-muted small mb-2">@Model.Enrollment.Course.ShortDescription</p>
                <ul class="list-unstyled small">
                    <li class="mb-1">
                        <i class="fas fa-user text-primary me-2"></i>
                        @Model.Enrollment.Course.Instructor.FullName
                    </li>
                    <li class="mb-1">
                        <i class="fas fa-tag text-primary me-2"></i>
                        @Model.Enrollment.Course.Category.Name
                    </li>
                    <li class="mb-1">
                        <i class="fas fa-calendar text-primary me-2"></i>
                        Đăng ký: @Model.Enrollment.EnrollmentDate.ToString("dd/MM/yyyy")
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            }

        .progress-circle {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto;
        }

            .progress-circle::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                border: 8px solid #e9ecef;
                z-index: 1;
            }

            .progress-circle::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                border: 8px solid transparent;
                border-top-color: #007bff;
                transform: rotate(-90deg);
                transition: transform 0.5s ease;
                z-index: 2;
            }

            .progress-circle span {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                font-size: 1.2rem;
                font-weight: bold;
                color: #007bff;
                z-index: 3;
            }

        [data-theme="dark"] .card {
            background: #2d3748;
            color: #e5e7eb;
        }

        [data-theme="dark"] .text-muted {
            color: #a0aec0 !important;
        }

        [data-theme="dark"] .bg-light {
            background: #4a5568 !important;
        }

        [data-theme="dark"] .progress-circle::before {
            border-color: #4a5568;
        }

        [data-theme="dark"] .progress-circle::after {
            border-top-color: #4e73df;
        }

        [data-theme="dark"] .progress-circle span {
            color: #4e73df;
        }
    </style>
}

@section Scripts {
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script>
        AOS.init({ duration: 800, once: true });

        let video = document.getElementById('lessonVideo');
        let lastUpdateTime = 0;
        let updateInterval = 15; 

        if (video) {
            // Update progress every 15 seconds
            video.addEventListener('timeupdate', function() {
                let currentTime = Math.floor(video.currentTime);
                if (currentTime - lastUpdateTime >= updateInterval || currentTime === 0) {
                    updateProgress(currentTime);
                    lastUpdateTime = currentTime;
                }
            });

            video.addEventListener('ended', function() {
                updateProgress(Math.floor(video.duration));
            });
            video.addEventListener('pause', function() {
                updateProgress(Math.floor(video.currentTime));
            });

            let savedPosition = @Model.LessonProgress.WatchedDuration;
            if (savedPosition > 0 && !@Model.LessonProgress.IsCompleted.ToString().ToLower()) {
                video.currentTime = savedPosition;
                video.play().catch(error => console.log("Auto-play prevented:", error));
            }
        }

        function updateProgress(watchedDuration) {
            const lessonId = '@Model.CurrentLesson.Id';
            fetch('@Url.Action("UpdateProgress", "Learning", new { area = "Student" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({
                    lessonId: lessonId,
                    watchedDuration: watchedDuration
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success && data.isCompleted && !@Model.LessonProgress.IsCompleted.ToString().ToLower()) {
                    showCompletionNotification();
                    setTimeout(() => location.reload(), 2000);
                }
            })
            .catch(error => console.error('Error updating progress:', error));
        }

        function showCompletionNotification() {
            let toast = $(`
                <div class="toast align-items-center position-fixed top-0 end-0 m-3" style="z-index: 9999;" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="toast-header bg-success text-white">
                        <i class="fas fa-check-circle me-2"></i>
                        <strong class="me-auto">Chúc mừng!</strong>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body text-dark">
                        Bạn đã hoàn thành bài học này!
                    </div>
                </div>
            `);

            $('body').append(toast);
            let toastEl = new bootstrap.Toast(toast[0], { delay: 3000 });
            toastEl.show();

            toast[0].addEventListener('hidden.bs.toast', () => toast.remove());
        }
        document.getElementById('lessonSearch').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase();
            document.querySelectorAll('.list-group-item').forEach(item => {
                const title = item.getAttribute('data-title');
                item.style.display = title.includes(query) ? '' : 'none';
            });
        });
        $(document).ready(function() {
            let progress = 0;
            let circle = $('.progress-circle');
            let rotation = (progress / 100) * 360 - 90;
            circle.find('::after').css('transform', `rotate(${rotation}deg)`);
        });
    </script>
    <style>
        .search-box {
            position: relative;
            max-width: 100%;
        }

            .search-box .form-control {
                padding-left: 2.5rem;
                border: 1px solid #ced4da;
                background-color: #fff;
            }

            .search-box .search-icon {
                position: absolute;
                left: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
                pointer-events: none;
            }
        .bg-light-primary {
            background-color: rgba(13, 110, 253, 0.1) !important;
        }

        .list-group-item:hover {
            background-color: #f8f9fa !important;
        }

        #lessonSearch:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }
    </style>
}