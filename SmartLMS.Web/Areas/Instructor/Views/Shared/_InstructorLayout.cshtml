<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community/styles/ag-theme-alpine.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="border-end bg-white shadow-sm" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-4 border-bottom">
                <div class="d-flex align-items-center justify-content-center">
                    <i class="fas fa-chalkboard-teacher text-primary me-2" style="font-size: 1.8rem;"></i>
                    <h5 class="mb-0 fw-bold text-primary">Giảng viên</h5>
                </div>
            </div>
            <div class="list-group list-group-flush mt-3">
                <a class="list-group-item list-group-item-action border-0 py-3 @((Context.Request.Path.StartsWithSegments("/Teacher/Dashboard")) ? "active" : "")"
                   asp-area="Teacher" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-tachometer-alt me-3 text-primary"></i>
                    <span class="fw-medium">Tổng quan</span>
                </a>
                <a class="list-group-item list-group-item-action border-0 py-3 @((Context.Request.Path.StartsWithSegments("/Teacher/Courses")) ? "active" : "")"
                   asp-area="Teacher" asp-controller="Courses" asp-action="Index">
                    <i class="fas fa-book-open me-3 text-success"></i>
                    <span class="fw-medium">Khóa học của tôi</span>
                </a>
                <a class="list-group-item list-group-item-action border-0 py-3 @((Context.Request.Path.StartsWithSegments("/Teacher/Quizzes")) ? "active" : "")"
                   asp-area="Teacher" asp-controller="Quizzes" asp-action="Index">
                    <i class="fas fa-clipboard-list me-3 text-warning"></i>
                    <span class="fw-medium">Quiz & Bài tập</span>
                </a>
                <a class="list-group-item list-group-item-action border-0 py-3 @((Context.Request.Path.StartsWithSegments("/Teacher/Students")) ? "active" : "")"
                   asp-area="Teacher" asp-controller="Students" asp-action="Index">
                    <i class="fas fa-users me-3 text-info"></i>
                    <span class="fw-medium">Học viên</span>
                </a>
                <a class="list-group-item list-group-item-action border-0 py-3 @((Context.Request.Path.StartsWithSegments("/Teacher/Analytics")) ? "active" : "")"
                   asp-area="Teacher" asp-controller="Analytics" asp-action="Index">
                    <i class="fas fa-chart-line me-3 text-purple"></i>
                    <span class="fw-medium">Thống kê</span>
                </a>
                <hr class="my-3 mx-3 border-secondary" />
                <a class="list-group-item list-group-item-action border-0 py-3"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home me-3 text-muted"></i>
                    <span class="fw-medium text-muted">Về trang chủ</span>
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <!-- Top Bar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
                <div class="container-fluid">
                    <button class="btn btn-outline-primary me-3" id="menu-toggle">
                        <i class="fas fa-bars"></i>
                    </button>

                    <div class="ms-auto d-flex align-items-center gap-3">
                        <!-- Notification -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary position-relative" data-bs-toggle="dropdown">
                                <i class="fas fa-bell"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                    3
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="width: 300px;">
                                <li><h6 class="dropdown-header">Thông báo</h6></li>
                                <li><a class="dropdown-item py-2" href="#">Học viên mới đăng ký khóa học</a></li>
                                <li><a class="dropdown-item py-2" href="#">Quiz cần chấm điểm</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-center text-primary" href="#">Xem tất cả</a></li>
                            </ul>
                        </div>

                        <!-- Theme Toggle -->
                        <button class="btn btn-sm btn-outline-secondary" id="theme-toggle" title="Chế độ tối">
                            <i class="fas fa-moon"></i>
                        </button>

                        <!-- User Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-outline-primary d-flex align-items-center gap-2 dropdown-toggle" data-bs-toggle="dropdown">
                                <img src="https://ui-avatars.com/api/?name=@User.Identity?.Name&background=4361ee&color=fff&size=32"
                                     alt="Avatar" class="rounded-circle" width="32">
                                <span class="d-none d-md-inline">@User.Identity?.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Teacher" asp-action="Profile">
                                        <i class="fas fa-user me-2"></i>Hồ sơ
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="container-fluid p-4">
                <!-- Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Page Content -->
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/js/popup-helper.js"></script>
    <script src="~/js/notion.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community@31.3.2/dist/ag-grid-community.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        // Toggle sidebar
        $("#menu-toggle").click(function(e) {
            e.preventDefault();
            $("#wrapper").toggleClass("toggled");
        });

        // Auto-hide alerts
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Theme toggle
        const themeToggle = document.getElementById('theme-toggle');
        themeToggle.addEventListener('click', () => {
            const currentTheme = document.body.getAttribute('data-theme');
            if (currentTheme === 'dark') {
                document.body.removeAttribute('data-theme');
                themeToggle.innerHTML = '<i class="fas fa-moon"></i>';
            } else {
                document.body.setAttribute('data-theme', 'dark');
                themeToggle.innerHTML = '<i class="fas fa-sun"></i>';
            }
            localStorage.setItem('theme', document.body.getAttribute('data-theme') || 'light');
        });

        // Load theme from localStorage
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
            document.body.setAttribute('data-theme', savedTheme);
            themeToggle.innerHTML = savedTheme === 'dark' ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>