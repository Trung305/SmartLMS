@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 text-center">
            <i class="fas fa-ban fa-5x text-danger mb-4"></i>
            <h1 class="display-4">403</h1>
            <h2 class="text-danger">Truy cập bị từ chối</h2>
            <p class="text-muted mt-3">
                Bạn không có quyền truy cập trang này.
            </p>
            <div class="mt-3">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary me-2">
                    <i class="fas fa-home me-2"></i>Về trang chủ
                </a>
                @if (!User.Identity?.IsAuthenticated == true)
                {
                    <a href="@Url.Action("Login", "Account")" class="btn btn-success">
                        <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                    </a>
                }
            </div>
        </div>
    </div>
</div>